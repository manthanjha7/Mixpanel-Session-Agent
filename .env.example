# Copy to .env and fill in. .env is gitignored, never commit real secrets.

# Required. Your Mixpanel project API secret (Project Settings, "Access Keys").
# Used as the basic-auth username against the Raw Export API.
MIXPANEL_API_SECRET=your-project-api-secret

# Required. The numeric project id to export from (Project Settings, "Overview").
MIXPANEL_PROJECT_ID=your-project-id

# Optional. Client project token, only used to build "Watch replay" deep links.
# MIXPANEL_PROJECT_TOKEN=your-project-token
